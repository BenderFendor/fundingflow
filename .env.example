# Local Rust API
DATABASE_URL=postgres://fundingflow:fundingflow@localhost:5432/fundingflow
PORT=3001
RUST_LOG=info
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Next.js server-side API origin and browser fallback
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Docker Compose
POSTGRES_PASSWORD=fundingflow
WEB_PORT=3000
API_PORT=3001

# Optional source credentials and required source identification
FEC_API_KEY=
REGULATIONS_GOV_API_KEY=
SEC_USER_AGENT=FundingFlow/0.1 your-email@example.com
